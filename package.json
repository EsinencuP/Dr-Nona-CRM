{
  "name": "dr-nona-moldova-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "npm run db:generate && next dev --port 3001",
    "build": "npm run db:generate && next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:push": "prisma db push --schema database/schema.prisma",
    "sync:catalog": "node scripts/sync-shared-data.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.12.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.26",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
