# Pooled URL for the application and direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required in production. Local development is open when both values are empty.
CRM_BASIC_USER=""
CRM_BASIC_PASSWORD=""

# Public e-catalog origins allowed to submit applications through the CRM API.
CONTACT_ALLOWED_ORIGINS="http://127.0.0.1:4173"

# Server-only Telegram delivery.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
