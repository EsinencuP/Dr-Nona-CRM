generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── TABLE 1: Client ───────────────────────────────────────────────────────
// One row per unique customer. Deduplication key = phoneNormalized.
// When a new order arrives with the same phoneNormalized, we UPSERT:
// update existing client data, then create a new Order linked to this client.
model Client {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  phone           String                       // Raw phone as entered by user
  phoneNormalized String   @unique              // Normalized: "+37369123456"
  email           String?                      // Optional
  region          String                       // Moldova region from dropdown
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customerNotificationsOptOutAt DateTime?

  orders          Order[]
  profileAudits   ClientProfileAudit[]
  notes           ClientNote[]

  @@index([region])                            // For future "sales by region" reports
}

model ClientNote {
  id        String   @id @default(uuid())
  clientId  String
  body      String
  actor     String
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientProfileAudit {
  id        String   @id @default(uuid())
  clientId  String
  actor     String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ReportExportAudit {
  id          String   @id @default(uuid())
  actor       String
  report      String
  columns     Json
  fromDate    DateTime?
  toDate      DateTime?
  includeDemo Boolean  @default(false)
  outcome     String
  rowCount    Int?
  fileBytes   Int?
  errorCode   String?
  createdAt   DateTime @default(now())

  @@index([actor, createdAt])
  @@index([createdAt])
}

enum OrderType {
  order
  consultation
  masterclass
}

enum OrderStatus {
  NEW
  PROCESSING
  DELIVERY
  DONE
  CANCELLED
}

enum ConsultationSlotState {
  OPEN
  RESERVED
  CLOSED
  CANCELLED
}

enum CustomerNotificationState {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  NEEDS_REVIEW
}

// ─── TABLE 2: Order ────────────────────────────────────────────────────────
// One row per incoming request (order / consultation / masterclass).
// Status lifecycle: NEW → PROCESSING → DELIVERY → DONE | CANCELLED
// UTM fields are filled automatically from URL params (server reads them from body).
model Order {
  id                  String   @id @default(uuid())
  clientId            String
  type                OrderType
  status              OrderStatus @default(NEW)
  locale              String   @default("ru-MD")

  // Optional fields — filled depending on request type
  comment             String?                  // Free-text comment from client
  preferredCallTime   String?                  // e.g. "After 18:00"
  eventDate           String?                  // "2026-09-05" (consultation / masterclass)
  eventTime           String?                  // "14:00"
  masterclassTopic    String?                  // Only for type="masterclass"
  consultationMode    String?                  // "online" | "offline"

  // Immutable contact snapshot exactly as submitted with this request.
  submittedFirstName  String
  submittedLastName   String
  submittedPhone      String
  submittedEmail      String?
  submittedRegion     String

  // Marketing analytics — collected automatically from URL
  utmSource           String?                  // e.g. "facebook", "instagram", "google"
  utmMedium           String?                  // e.g. "cpc", "story", "organic"
  utmCampaign         String?                  // e.g. "solaris_promo_august"
  utmContent          String?                  // e.g. "blue_banner"

  // Behavior analytics
  entryPoint          String?                  // URL of the page where form was submitted
  sessionHistory      String?                  // JSON string: ["slug1", "slug2"] — product views before order
  attribution         Json?                    // Versioned, normalized analytics context; never used for authorization

  // First valid transition away from NEW. Historical rows are intentionally left null.
  firstActionAt       DateTime?

  // Telegram sync — needed to update status when manager replies
  telegramMessageId   String?  @unique         // message_id returned by Telegram sendMessage API

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              Client   @relation(fields: [clientId], references: [id])
  items               OrderItem[]
  applicationSubmission ApplicationSubmission?
  telegramOutbox      TelegramOutbox?
  statusAudits        OrderStatusAudit[]
  telegramCommandAudits TelegramCommandAudit[]
  reservedConsultationSlot ConsultationSlot? @relation("ReservedConsultationSlot")
  customerNotifications CustomerNotification[]

  @@index([clientId])                          // Fast lookup of all orders by one client
  @@index([createdAt])                         // For time-range queries (seasonality reports)
  @@index([status, createdAt])                 // For CRM list: filter by status + sort by date
  @@index([utmSource])                         // For marketing channel performance reports
}

model CustomerNotification {
  id                String                    @id @default(uuid())
  orderId           String
  status            OrderStatus
  locale            String
  recipient         String
  templateKey       String
  body              String
  provider          String
  state             CustomerNotificationState @default(PENDING)
  attempts          Int                       @default(0)
  providerMessageId String?                   @unique
  cost              Float?
  currency          String?
  lastErrorCode     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, status])
  @@index([state, createdAt])
}

model ConsultationSlot {
  id              String                @id @default(uuid())
  startsAt        DateTime              @unique
  endsAt          DateTime
  mode            String
  state           ConsultationSlotState @default(OPEN)
  reservedOrderId String?               @unique
  reservedAt      DateTime?
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  reservedOrder   Order?                @relation("ReservedConsultationSlot", fields: [reservedOrderId], references: [id], onDelete: SetNull)
  audits          ConsultationSlotAudit[]

  @@index([state, startsAt])
}

model ConsultationSlotAudit {
  id        String                @id @default(uuid())
  slotId    String
  actor     String
  fromState ConsultationSlotState?
  toState   ConsultationSlotState
  reason    String?
  createdAt DateTime              @default(now())

  slot      ConsultationSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId, createdAt])
}

model OrderStatusAudit {
  id         String      @id @default(uuid())
  orderId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  source     String
  actorKey   String
  createdAt  DateTime    @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([createdAt])
}

enum TelegramOutboxState {
  PENDING
  SENDING
  DELIVERED
  NEEDS_REVIEW
  TERMINAL
  CANCELLED
}

model TelegramOutbox {
  orderId           String              @id
  payload           String
  state             TelegramOutboxState @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lockedAt          DateTime?
  lastAttemptAt     DateTime?
  lastErrorCode     String?
  providerMessageId String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
  @@index([updatedAt])
}

model TelegramCommandAudit {
  id        String   @id @default(uuid())
  updateId  String   @unique
  actorKey  String
  command   String
  outcome   String
  orderId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([actorKey, createdAt])
  @@index([orderId, createdAt])
}

enum ApplicationSubmissionState {
  DELIVERY_STARTED
  DELIVERED
  DELIVERY_FAILED
}

// Persistent idempotency record. Raw idempotency keys and request payloads are never stored.
model ApplicationSubmission {
  keyHash           String                     @id
  payloadHash       String
  requestId         String                     @unique
  state             ApplicationSubmissionState @default(DELIVERY_STARTED)
  providerMessageId String?
  lastErrorCode     String?
  expiresAt         DateTime
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  order             Order                      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@index([expiresAt])
}

// Fixed-window counter shared by every serverless instance. clientKey is already HMAC-anonymized by the trusted proxy.
model ApplicationRateLimitBucket {
  id          String   @id
  clientKey   String
  windowStart DateTime
  attempts    Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

// ─── TABLE 3: OrderItem ────────────────────────────────────────────────────
// One row per product line in an order.
// productSlug matches the slug field in products.json on the frontend.
// priceAtPurchase is the internal price AT THE TIME of the order (snapshot).
// Default is 0.0 — prices will be entered later when CRM is launched.
model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productSlug      String                       // e.g. "solaris-body-lotion"
  quantity         Int      @default(1)         // Number of units ordered
  priceAtPurchase  Float    @default(0.0)       // Internal price snapshot (hidden from clients)
  retailPriceAtPurchase Float @default(0.0)     // Fixed retail snapshot; zero means unavailable
  distributorPriceAtPurchase Float @default(0.0) // Fixed purchase-cost snapshot

  order            Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])                           // Fast lookup of all items in one order
  @@index([productSlug])                       // For "popularity by product" reports
}

// ─── TABLE 4: ProductCatalog ───────────────────────────────────────────────
// Internal price registry. Prices are NEVER shown on the website.
// This table is a stub — prices will be entered manually via CRM later.
// slug must match the product slug from products.json exactly.
model ProductCatalog {
  slug          String   @id                   // e.g. "solaris-body-lotion"
  sku           String                         // e.g. "413001"
  internalPrice Float    @default(0.0)         // Internal cost for revenue calculation
  retailPrice Float @default(0.0)             // Approved catalogue retail price, MDL
  distributorPrice Float @default(0.0)        // Approved distributor purchase price, MDL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
